# Versions and sha256 pins of hack/e2e-kwok.sh (make e2e-kwok). A version bump changes its
# checksums: the release asset's digest for kwokctl and the CRDs, the GitHub source tarball's
# (https://github.com/<repo>/archive/refs/tags/<tag>.tar.gz) for what is built from source.

# kwokctl, binary runtime (a real kube-apiserver, etcd, scheduler and controller manager;
# kwok plays the kubelets): no container runtime needed.
# renovate: datasource=github-releases depName=kubernetes-sigs/kwok extractVersion=^v(?<version>.+)$
KWOK_VERSION=0.8.0
# renovate: datasource=github-releases depName=kubernetes/kubernetes extractVersion=^v(?<version>.+)$
KWOK_KUBE_VERSION=1.37.2
KWOK_SHA256_KWOKCTL_LINUX_AMD64=d5743166c657283d6e827c7c4c20cacfd9009fd94830f06718ca7b2c7099461f
KWOK_SHA256_KWOKCTL_LINUX_ARM64=5a642b27d3e975f36040d215640cd90fb4a63cb6fca0ad5865a61bcd9c81051b
KWOK_SHA256_KWOKCTL_DARWIN_AMD64=16bccb569c36ac6b124b2521cfe71c4e4133cf22159c82d4698a3412646e9789
KWOK_SHA256_KWOKCTL_DARWIN_ARM64=9323a59adb9c27854bd2a76652ad00258bcbb68acc40aba0dc21e362b67b7d6a

# Flux's helm-controller and source-controller, built from their tags (the releases publish
# images only); their CRDs from the release.
# renovate: datasource=github-releases depName=fluxcd/helm-controller extractVersion=^v(?<version>.+)$
FLUX_HELM_CONTROLLER_VERSION=1.6.5
FLUX_HELM_CONTROLLER_SHA256_SRC=8defa71e63efbe00ffcefb2ac7df695bccdc1192683707da0c16cc8489c6aed2
FLUX_HELM_CONTROLLER_SHA256_CRDS=8af19966e63cccde7d2c62e24c7bd3466010dd53e9d063e2ce22d1391e11f272
# renovate: datasource=github-releases depName=fluxcd/source-controller extractVersion=^v(?<version>.+)$
FLUX_SOURCE_CONTROLLER_VERSION=1.9.6
FLUX_SOURCE_CONTROLLER_SHA256_SRC=8ff7734d07b51917970c845b194b7cfe9a8a504b12e570ef53013f9dd00f575e
FLUX_SOURCE_CONTROLLER_SHA256_CRDS=5acf3b01c24f15647a162f2d43b1287f0d0156fab0026f4afb9865874cdbe16d

# Cluster API core: the manager built from the tag (go.mod's sigs.k8s.io/cluster-api), its
# CRDs from the same tree's config/crd/bases.
# renovate: datasource=github-releases depName=kubernetes-sigs/cluster-api
CAPI_VERSION=v1.13.8
CAPI_SHA256_SRC=e829bc24ecd750333ec37fbb985b4e76151594bb3c617aeb01b22011a9694375

# The chart the provider installs (source-controller pulls it from the repository).
VCLUSTER_CHART_REPO=https://charts.loft.sh
# renovate: datasource=helm depName=vcluster registryUrl=https://charts.loft.sh
VCLUSTER_CHART_VERSION=0.37.6
